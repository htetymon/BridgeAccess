# Supabase PostgreSQL Database
SUPABASE_DB_HOST=your-project-ref.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Full JDBC connection URL (built from the values above)
SUPABASE_DB_URL=jdbc:postgresql://your-project-ref.pooler.supabase.com:5432/postgres

# Gemini API (Google AI Studio). Server only: never put this key in the web app.
GEMINI_API_KEY=your-gemini-api-key
# Optional: model ID (check https://ai.google.dev/gemini-api/docs/models before changing)
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Storage for images (private bucket "package-images"). Server only.
# Project URL from Project Settings > API; secret key (sb_secret_...) or legacy service_role key.
# Leave both empty to store images on local disk (development).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
